[Unit]
Description=Hermes Cron Dashboard
After=network.target

[Service]
Type=simple
User=jack
WorkingDirectory=/home/jack/developer/workshop/hermes-cron-dashboard
Environment=HERMES_HOME=/home/jack/.hermes
Environment=PATH=/home/jack/.nvm/versions/node/v22.22.3/bin:/home/jack/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=PORT=3002
ExecStart=/home/jack/.nvm/versions/node/v22.22.3/bin/node /home/jack/developer/workshop/hermes-cron-dashboard/node_modules/.bin/next start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
